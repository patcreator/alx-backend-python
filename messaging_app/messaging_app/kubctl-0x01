#!/bin/bash

# Scale the deployment to 3 replicas
echo "Scaling Django app to 3 replicas..."
kubectl scale deployment django-messaging-app --replicas=3

# Wait for pods to be ready
echo "Waiting for pods to be ready..."
sleep 10

# Verify multiple pods are running
echo "Checking running pods..."
kubectl get pods

# Install wrk if not present
if ! command -v wrk &> /dev/null; then
    echo "Installing wrk for load testing..."
    sudo apt-get update && sudo apt-get install -y wrk
fi

# Get the service IP
SERVICE_IP=$(kubectl get svc django-messaging-service -o jsonpath='{.spec.clusterIP}')

# Perform load testing
echo "Performing load testing with wrk..."
wrk -t12 -c400 -d30s http://$SERVICE_IP/

# Monitor resource usage
echo "Monitoring resource usage..."
kubectl top pods

# Make script executable
chmod +x kubctl-0x01